@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.Models.Components;
@using ProjectNomad.Shared.Enums;
@using ProjectNomad.Shared.Interfaces;
@using ProjectNomad.Client.Models.Response;

@inject TasksManager _humanUnitTasksLocalStorageManager
@inject HttpClient _httpClient
@inject GameLooperManager _gameLooperManager
@inject NavigationManager _navigationManager
@inject EventBroadcastService _eventBroadcastService
@inject TaskOrderManager _taskOrderManager

@if (HumanUnitIds != null && HumanUnitTasks != null)
{
    <button type="button" class="button_active" style="width: 250px;" @onclick="OrderToGatherFood">zbierz jedzenie w okolicy</button>
    <br />
    <button type="button" class="button_active" style="width: 250px;" @onclick="OrderToGatherWood">zbierz drewno w okolicy</button>
    <br />
    @if (!TribeStructures.Any(x => x.Type == ETribeStructureType.Firecamp && x.PowerAndDurability > 0) && !HumanUnitTaskOrders.Any(x => x.Type == EHumanUnitTaskType.LightAFire))
    {
        <button type="button" class="button_active" style="width: 250px;" @onclick="OrderToLightFire">rozpal ognisko</button>
        <br />
    }
    else
    {
        <button type="button" class="button_inactive" style="width: 250px;">rozpal ognisko</button>
        <br />
    }
    @if (TribeStructures.Any(x => x.Type == ETribeStructureType.Firecamp && x.PowerAndDurability > 1))
    {
        <button type="button" class="button_active" style="width: 250px;" @onclick="OrderToKeepFire">utrzymuj ogień</button>
        <br />
    }
    else
    {
        <button type="button" class="button_inactive" style="width: 250px;">utrzymuj ogień</button>
        <br />
    }
    <br />


    @foreach (var autoTask in HumanUnitTasks.Where(x => HumanUnitTaskTypeExtensions.GetAutoTasks().Contains(x.Type)))
    {
        <ProjectNomad.Client.Components.TasksComponents.ProgressButton HumanUnitTask="autoTask" />
        <br />
    }

    <br />

    var buttons = new List<ButtonTaskOrders>();
    var notAssignedTasks = HumanUnitTasks.OrderByDescending(x => x.From).ToList();
    @foreach (var taskOrder in HumanUnitTaskOrders.OrderBy(x => x.Added))
    {
        var lastButton = buttons.LastOrDefault();

        IHumanUnitTaskDto matchingTask = null;

        if (taskOrder.IsInProgress)
            matchingTask = notAssignedTasks.OrderByDescending(x => x.From).FirstOrDefault(x => x.Type == taskOrder.Type);

        if (lastButton == null || taskOrder.Type != lastButton.Type)
        {
            var buttonToAdd = new ButtonTaskOrders { Type = taskOrder.Type, AllCount = 1, InProgressCount = taskOrder.IsInProgress ? 1 : 0 };
            if (matchingTask != null)
            {
                buttonToAdd.MatchedTasks.Add(matchingTask);
                notAssignedTasks.Remove(matchingTask);
            }
            buttons.Add(buttonToAdd);
        }
        else
        {
            if (taskOrder.IsInProgress)
                lastButton.InProgressCount++;
            lastButton.AllCount++;

            if (matchingTask != null)
                lastButton.MatchedTasks.Add(matchingTask);
        }
    }
    @foreach (var button in buttons)
    {
        var desc = HumanUnitTaskTypeExtensions.GetDescription(button.Type);
        @if (button.InProgressCount != button.AllCount)
        {
            <button type="button" class="button_active" style="width: 250px;">@(desc)(@button.InProgressCount/@button.AllCount)</button>
        }
        else
        {
            <button type="button" class="button_inactive" style="width: 250px;">@(desc)(@button.InProgressCount/@button.AllCount)</button>
        }

        foreach (var task in button.MatchedTasks)
        {
            <ProjectNomad.Client.Components.TasksComponents.ProgressButton HumanUnitTask="task" />
        }

        <br/>
    }


    <br />
    <br />
    <hr />
    @if (TribeStructures.Any(x => x.Type == ETribeStructureType.Firecamp))
    {
        @if (TribeStructures.Single(x => x.Type == ETribeStructureType.Firecamp).PowerAndDurability == 0)
        {
            <p>Po ognisku został jedynie popiół</p>
        }
        else
        {
            <p>Ognisko pali się (@TribeStructures.Single(x => x.Type == ETribeStructureType.Firecamp).PowerAndDurability%)</p>
        }
    }
    else
    {
        <p>Brak ogniska..</p>
    }
}
else
{
    <p>Loading..</p>
}


@code {
    [ParameterAttribute]
    public Tribe Tribe { get; set; }

    [ParameterAttribute]
    public IEnumerable<int> HumanUnitIds { get; set; }

    [ParameterAttribute]
    public IEnumerable<HumanUnitTaskOrder> HumanUnitTaskOrders { get; set; }

    [ParameterAttribute]
    public IEnumerable<IHumanUnitTaskDto> HumanUnitTasks { get; set; }

    [ParameterAttribute]
    public IEnumerable<ITribeStructure> TribeStructures { get; set; }


    IReadOnlyList<EHumanUnitTaskType> AutoTasks = new List<EHumanUnitTaskType>() { EHumanUnitTaskType.ConsumeFood };


    protected override async Task OnInitializedAsync()
    {
    }

    async Task OrderToLightFire()
        => _taskOrderManager.Add(Tribe.Id, EHumanUnitTaskType.LightAFire, Tribe.X, Tribe.Y);

    async Task OrderToKeepFire()
        => _taskOrderManager.Add(Tribe.Id, EHumanUnitTaskType.KeepFire, Tribe.X, Tribe.Y);

    async Task OrderToGatherFood()
        => _taskOrderManager.Add(Tribe.Id, EHumanUnitTaskType.GatheringFood, Tribe.X, Tribe.Y);

    async Task OrderToGatherWood()
        => _taskOrderManager.Add(Tribe.Id, EHumanUnitTaskType.GatheringWood, Tribe.X, Tribe.Y);
}