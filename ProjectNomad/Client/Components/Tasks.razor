@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.ViewModels.Tasks;
@using ProjectNomad.Shared.Enums;
@using ProjectNomad.Shared.Interfaces;

@inject HumanUnitTasksLocalStorageManager _humanUnitTasksLocalStorageManager
@inject HttpClient _httpClient
@inject GameLooperManager _gameLooperManager
@inject NavigationManager _navigationManager
@inject EventBroadcastService _eventBroadcastService

@if (HumanUnitIds != null && HumanUnitTasks != null)
{
    <span>» call for wood gathering(2/4)</span>
    <br />
    <small>[▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬------------] 4m22s</small>
    <br />
    <small>[▬▬▬▬▬▬▬▬▬---------------------] 24m22s</small>
    <br />

    <span>» call for food gathering(0/1)</span>
    <br />
    <span>» call for wood gathering(0/2)</span>
    <br />

    <hr/>

    <button class="button" @onclick="GatherFood"><span>gather food(@(HumanUnitIds.Count() - HumanUnitTasks.Count()))</span></button> @* TODO DISABLE WHEN NO FREE HUMAN UNITS.. *@
    <br />
    @foreach (var item in HumanUnitTasks.Where(x => x.Type == ProjectNomad.Shared.Enums.EHumanUnitTaskType.GatheringFood))
    {
        <ProjectNomad.Client.Components.TasksComponents.ProgressBar HumanUnitTask="item" TribeId="@TribeId" />
    } 
    <br />


    <button class="button"><span>Try unknown red colour berries</span></button>
    <button class="button"><span>Gather animal skull - 3d12m12s</span></button>
    <button class="button"><span>Catch fire after storm  - 15m36s</span></button>

    <br/>
    @if (HumanUnitTasks.Any(x => AutoTasks.Contains(x.Type)))
    {
        <button class="button">Food consumingª</button>
        <br/>
        @foreach (var item in HumanUnitTasks.Where(x => x.Type == ProjectNomad.Shared.Enums.EHumanUnitTaskType.ConsumeFood))
        {
            <ProjectNomad.Client.Components.TasksComponents.ProgressBar HumanUnitTask="item" TribeId="@TribeId" />
        }
        <br />
    }
    

}
else
{
    <p>Loading..</p>
}


@code {
    [ParameterAttribute]
    public int TribeId { get; set; }

    [ParameterAttribute]
    public IEnumerable<int> HumanUnitIds { get; set; }

    IEnumerable<IHumanUnitTaskDto> HumanUnitTasks;

    IReadOnlyList<EHumanUnitTaskType> AutoTasks = new List<EHumanUnitTaskType>() { EHumanUnitTaskType.ConsumeFood };

    protected override async Task OnInitializedAsync()
    {
        //_eventBroadcastService.OnAction += EventHandler; //TEMP - CHECKING EACH SEC
        await Reload();

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
            await Reload(); //TEMP TODO - ADD LOGIC
    }

    private void EventHandler(EActionWASM actionWASM)
    {
        if (actionWASM != EActionWASM.TaskEnded)
            return;

        Reload();
        _eventBroadcastService.ClearEvent();
    }

    private async Task Reload()
    {
        await _humanUnitTasksLocalStorageManager.SyncTasksWithServer(TribeId);
        HumanUnitTasks = await _humanUnitTasksLocalStorageManager.GetAllFromLocalStorageAndCleanOutdated();//WSUMIE TO PO CO CI TO TRZYMAĆ W LOCAL STORAGE??.. 
        StateHasChanged();
    }

    async Task GatherFood()
    {
        var humanUnitIdsWithTasksInProgress = HumanUnitTasks.Select(y => y.HumanUnitId);
        var humanUnitWithNoTaskId = HumanUnitIds.Where(x => !humanUnitIdsWithTasksInProgress.Contains(x)).FirstOrDefault();

        if (humanUnitWithNoTaskId == 0)
            throw new ArgumentOutOfRangeException("Ożesz WASM! GatherFood method was used but there is no humanUnit to assign. :/");

        var dto = new AddHumanUnitTaskViewModel(TribeId, 
            humanUnitWithNoTaskId,
            ProjectNomad.Shared.Enums.EHumanUnitTaskType.GatheringFood, 
            3, 3, 3, 3); //positions hardcoded

        await _humanUnitTasksLocalStorageManager.AddToServer(dto);
        HumanUnitTasks = await _humanUnitTasksLocalStorageManager.GetAllFromLocalStorageAndCleanOutdated();

        await _gameLooperManager.AddNotificationFromWASM(humanUnitWithNoTaskId, ENotificationType.FoodGatheringStarted, null);
        _eventBroadcastService.AddMessage(EActionWASM.NotificationAdded);
        //StateHasChanged();
    }
}