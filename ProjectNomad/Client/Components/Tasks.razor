@using ProjectNomad.Client.Logic;
@using ProjectNomad.Shared.Enums;
@using ProjectNomad.Shared.Interfaces;
@using ProjectNomad.Client.Models.Response;

@inject TasksManager _humanUnitTasksLocalStorageManager
@inject HttpClient _httpClient
@inject GameLooperManager _gameLooperManager
@inject NavigationManager _navigationManager
@inject EventBroadcastService _eventBroadcastService
@inject TaskOrderManager _taskOrderManager

@if (HumanUnitIds != null && HumanUnitTasks != null)
{
    <smaller>dev info - task orders:</smaller>
    @foreach (var humanUnitTaskOrder in HumanUnitTaskOrders)
    {
        <br />
        string descrption = humanUnitTaskOrder.Type == EHumanUnitTaskType.GatheringFood ? "Zbieraj jedzenie" 
            : humanUnitTaskOrder.Type == EHumanUnitTaskType.TribeRelocation ? "Przygotuj się do zmiany lokalizacji" 
            : humanUnitTaskOrder.Type == EHumanUnitTaskType.GatheringWood ? "Zbieraj drewno"
            : humanUnitTaskOrder.Type == EHumanUnitTaskType.LightAFire ? "Rozpal ognisko"
            : humanUnitTaskOrder.Type == EHumanUnitTaskType.KeepFire ? "Utrzymuj ogień"
            :"todo";
        <span>» @descrption (0/1)</span>
    } 
    <hr />

    <smaller>dev info - food gather tasks:</smaller>
    @foreach (var item in HumanUnitTasks.Where(x => x.Type == ProjectNomad.Shared.Enums.EHumanUnitTaskType.GatheringFood))
    {
        <br />
        <ProjectNomad.Client.Components.TasksComponents.ProgressBar HumanUnitTask="item" TribeId="@Tribe.Id" />
    }
    <hr />

    <smaller>dev info - wood gather tasks:</smaller>
    @foreach (var item in HumanUnitTasks.Where(x => x.Type == ProjectNomad.Shared.Enums.EHumanUnitTaskType.GatheringWood))
    {
        <br />
        <ProjectNomad.Client.Components.TasksComponents.ProgressBar HumanUnitTask="item" TribeId="@Tribe.Id" />
    }
    <hr />

    <smaller>dev info - fire tasks:</smaller>
    @if (TribeStructures.Any(x => x.Type == ETribeStructureType.Firecamp))
    {
        @if (TribeStructures.Single(x => x.Type == ETribeStructureType.Firecamp).PowerAndDurability == 0)
        {
            <p>Po ognisku został jedynie popiół</p>
        }
        else
        {
            <p>Ognisko pali się (@TribeStructures.Single(x => x.Type == ETribeStructureType.Firecamp).PowerAndDurability%)</p>            
        }
    }
    else
    {
        <p>Brak ogniska..</p>
    }

    @foreach (var item in HumanUnitTasks.Where(x => x.Type == ProjectNomad.Shared.Enums.EHumanUnitTaskType.LightAFire))
    {
        <br />
        <smaller>rozpalanie ogniska</smaller>
        <ProjectNomad.Client.Components.TasksComponents.ProgressBar HumanUnitTask="item" TribeId="@Tribe.Id" />
    }
    @foreach (var item in HumanUnitTasks.Where(x => x.Type == ProjectNomad.Shared.Enums.EHumanUnitTaskType.KeepFire))
    {
        <br />
        <smaller>utrzymanie ognia</smaller>
        <ProjectNomad.Client.Components.TasksComponents.ProgressBar HumanUnitTask="item" TribeId="@Tribe.Id" />
    }
    <hr />

    <smaller>dev info - auto tasks:</smaller>
    <br />
    @if (HumanUnitTasks.Any(x => AutoTasks.Contains(x.Type)))
    {
        <button class="button">Food consumingª</button>
        @foreach (var item in HumanUnitTasks.Where(x => x.Type == ProjectNomad.Shared.Enums.EHumanUnitTaskType.ConsumeFood))
        {
            <br />
            <ProjectNomad.Client.Components.TasksComponents.ProgressBar HumanUnitTask="item" TribeId="@Tribe.Id" />
        }
    }
    <hr />

    @if (!TribeStructures.Any(x => x.Type == ETribeStructureType.Firecamp && x.PowerAndDurability > 0) && !HumanUnitTaskOrders.Any(x => x.Type == EHumanUnitTaskType.LightAFire))
    {
        <button class="button" @onclick="OrderToLightFire"><span>call for order to light a fire</span></button>
        <br />
    }
    @if (TribeStructures.Any(x => x.Type == ETribeStructureType.Firecamp && x.PowerAndDurability > 1))
    {
        <button class="button" @onclick="OrderToKeepFire"><span>call to keep the fire going low</span></button>
        <br />
    }

    <button class="button" @onclick="OrderToGatherFood"><span>call to gather food near camp</span></button>
    <br />
    <button class="button" @onclick="OrderToGatherWood"><span>call to gather wood near camp</span></button>
    <br />
}
else
{
    <p>Loading..</p>
}


@code {
    [ParameterAttribute]
    public Tribe Tribe { get; set; }

    [ParameterAttribute]
    public IEnumerable<int> HumanUnitIds { get; set; }

    [ParameterAttribute]
    public IEnumerable<HumanUnitTaskOrder> HumanUnitTaskOrders { get; set; }

    [ParameterAttribute]
    public IEnumerable<IHumanUnitTaskDto> HumanUnitTasks { get; set; }

    [ParameterAttribute]
    public IEnumerable<ITribeStructure> TribeStructures { get; set; }


    IReadOnlyList<EHumanUnitTaskType> AutoTasks = new List<EHumanUnitTaskType>() { EHumanUnitTaskType.ConsumeFood };


    protected override async Task OnInitializedAsync()
    {
    }

    async Task OrderToLightFire()
        => _taskOrderManager.Add(Tribe.Id, EHumanUnitTaskType.LightAFire, Tribe.X, Tribe.Y);

    async Task OrderToKeepFire()
        => _taskOrderManager.Add(Tribe.Id, EHumanUnitTaskType.KeepFire, Tribe.X, Tribe.Y);

    async Task OrderToGatherFood()
        => _taskOrderManager.Add(Tribe.Id, EHumanUnitTaskType.GatheringFood, Tribe.X, Tribe.Y);

    async Task OrderToGatherWood()
        => _taskOrderManager.Add(Tribe.Id, EHumanUnitTaskType.GatheringWood, Tribe.X, Tribe.Y);
}