@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.Models.Components;
@using ProjectNomad.Shared.Enums;
@using ProjectNomad.Shared.Interfaces;
@using ProjectNomad.Client.Models.Response;

@inject TasksManager _humanUnitTasksLocalStorageManager
@inject HttpClient _httpClient
@inject GameLooperManager _gameLooperManager
@inject NavigationManager _navigationManager
@inject EventBroadcastService _eventBroadcastService
@inject TaskOrderManager _taskOrderManager

@if (HumanUnitIds != null && HumanUnitTasks != null)
{
    <ProjectNomad.Client.Components.MapTileActions />    

    @foreach (var autoTask in HumanUnitTasks.Where(x => TaskTypeExtensions.GetAutoTasks().Contains(x.Type)))
    {
        <ProjectNomad.Client.Components.TasksComponents.ProgressButton HumanUnitTask="autoTask" />
    }

    <br />

    @foreach (var jobTasks in HumanUnitTasks.Where(x => TaskTypeExtensions.GetJobs().Contains(x.Type)))
    {
        <ProjectNomad.Client.Components.TasksComponents.ProgressButton HumanUnitTask="jobTasks" />
    }
}
else
{
    <p>Loading..</p>
}


<br />
<br />

@code {
    [ParameterAttribute]
    public Tribe Tribe { get; set; }

    [ParameterAttribute]
    public IEnumerable<int> HumanUnitIds { get; set; }

    [ParameterAttribute]
    public IEnumerable<HumanUnitTaskOrder> HumanUnitTaskOrders { get; set; }

    [ParameterAttribute]
    public IEnumerable<IHumanTaskDto> HumanUnitTasks { get; set; }

    [ParameterAttribute]
    public IEnumerable<ITribeStructure> TribeStructures { get; set; }

    protected override async Task OnInitializedAsync()
    {
    }

}