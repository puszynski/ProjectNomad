    <br />
    <br />
    <hr />
    @if (TribeStructures.Any(x => x.Type == ETribeStructureType.Firecamp))
    {
        @if (TribeStructures.Single(x => x.Type == ETribeStructureType.Firecamp).PowerAndDurability == 0)
        {
            <p>Po ognisku został jedynie popiół</p>
        }
        else
        {
            <p>Ognisko pali się (@TribeStructures.Single(x => x.Type == ETribeStructureType.Firecamp).PowerAndDurability%)</p>
        }
    }
    else
    {
        <p>Brak ogniska..</p>
    }
}
else
{
    <p>Loading..</p>
}


@code {
    [ParameterAttribute]
    public Tribe Tribe { get; set; }

    [ParameterAttribute]
    public IEnumerable<int> HumanUnitIds { get; set; }

    [ParameterAttribute]
    public IEnumerable<HumanUnitTaskOrder> HumanUnitTaskOrders { get; set; }

    [ParameterAttribute]
    public IEnumerable<IHumanTaskDto> HumanUnitTasks { get; set; }

    [ParameterAttribute]
    public IEnumerable<ITribeStructure> TribeStructures { get; set; }


    IReadOnlyList<ETaskType> AutoTasks = new List<ETaskType>() { ETaskType.ConsumeFood };


    protected override async Task OnInitializedAsync()
    {
    }

    async Task OrderCampfireUp()
        => _taskOrderManager.Add(Tribe.Id, ETaskType.CampfireUp, Tribe.X, Tribe.Y);

    async Task OrderToGatherFood()
        => _taskOrderManager.Add(Tribe.Id, ETaskType.GatheringFood, Tribe.X, Tribe.Y);

    async Task OrderToGatherWood()
        => _taskOrderManager.Add(Tribe.Id, ETaskType.GatheringWood, Tribe.X, Tribe.Y);
}