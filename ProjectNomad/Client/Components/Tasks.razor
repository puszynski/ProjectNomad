            {
                buttonToAdd.MatchedTasks.Add(matchingTask);
            }
            buttons.Add(buttonToAdd);
        }
        else
        {
            if (taskOrder.HumanTaskId.HasValue)
                lastButton.InProgressCount++;
            lastButton.AllCount++;

            if (matchingTask != null)
                lastButton.MatchedTasks.Add(matchingTask);
        }
    } *@
    @* ⏵⏸ *@

    @* @foreach (var button in buttons)
    {
        var desc = TaskTypeExtensions.GetDescription(button.Type);
        var symbol = TaskTypeExtensions.GetSymbol(button.Type);

        @if (TaskTypeExtensions.GetConstantTasks().Contains(button.Type))
        {
            if (button.InProgressCount != button.AllCount)
            {
                <button type="button" class="button_active" style="width: 250px;">@(desc) @symbol</button>
            }
            else
            {
                <button type="button" class="button_inactive" style="width: 250px;">@(desc) @symbol</button>
            }
        }
        else
        {
            if (button.InProgressCount != button.AllCount)
            {
                <button type="button" class="button_active" style="width: 250px;">@(desc) @button.InProgressCount/@button.AllCount@symbol</button>
            }
