@using Blazored.LocalStorage;
@using ProjectNomad.Client.Logic;
@inject HttpClient _httpClient
@inject ILocalStorageService _localStorageService
@inject TribeNotificationsLocalStorageAndServerManager _tribeNotificationsLoclStorageAndServerManager;
@inject EventBroadcastService _eventBroadcastService;

@if (TribeNotifications is not null)
{
    <button class="button" @onclick="RefreshNotifications"><span>Ask tribe member for news &#8634;</span></button>
    @* todo when clicked - display info "waitng for news.." - after few sec button is back *@


    @if (TribeNotifications.Any())
    {
        foreach (var item in TribeNotifications)
        {
            <p>@item.HumanUnitId (@item.Added) => @item.Type.ToString()</p>
        }
    }
    else
    {
        <p>Nothing has happend...</p>
    }
}




@code {
    List<TribeNotificationDto> TribeNotifications;

    [ParameterAttribute]
    public int TribeId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _eventBroadcastService.OnAction += EventHandler;
        TribeNotifications = new List<TribeNotificationDto>();
        await RefreshNotifications();        
    }

    private void EventHandler(EActionWASM actionWASM)
    {
        if (actionWASM != EActionWASM.NotificationAdded)
            return;

        RefreshNotifications();
        _eventBroadcastService.ClearEvent();
    }

    internal async Task RefreshNotifications()
    {
        await _tribeNotificationsLoclStorageAndServerManager.GetAllAndRemoveOutdated(TribeId);
        TribeNotifications = _tribeNotificationsLoclStorageAndServerManager.TribeNotifications;
        StateHasChanged();
    }

    internal class TribeNotificationDto : ProjectNomad.Shared.Interfaces.ITribeNotification
    {
        public int HumanUnitId { get; set; }
        public DateTime Added { get; set; }
        public ProjectNomad.Shared.Enums.EHumanNotificationType Type { get; set; }
    }
}
