@using ProjectNomad.Client.Logic.GameLooperManagerLogic;
@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.Models.Response;

@inject HttpClient _httpClient
@inject GameLooperManager _gameLooperManager
@inject EventBroadcastService _eventBroadcastService;

@if (NotificationsToDisplay is not null)
{
    @if (NotificationsToDisplay.Any())
    {
        foreach (var item in NotificationsToDisplay)
        {
            var desc = @item.GetDescription();

            if (string.IsNullOrEmpty(desc))
                continue;

            <smaller>@item.GetDescription()</smaller>
            <br/>  
        }
    }
    else
    {
        <smaller>Nothing has happend...</smaller>
    }
}

@code {
    IEnumerable<Notification>? NotificationsToDisplay;

    [ParameterAttribute]
    public int TribeId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _eventBroadcastService.OnAction += EventHandler;
        await RefreshNotifications();        
    }

    private void EventHandler(EActionWASM actionWASM, string values)
    {
        if (actionWASM != EActionWASM.NotificationAdded)
            return;

        RefreshNotifications();
        _eventBroadcastService.ClearEvent();
    }

    internal async Task RefreshNotifications()
    {
        NotificationsToDisplay = await _gameLooperManager.GetNotifications();
        StateHasChanged();
    }
}
