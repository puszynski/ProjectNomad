@using Blazored.LocalStorage;
@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.Logic.NotificationsManagerLogic;
@inject HttpClient _httpClient
@inject ILocalStorageService _localStorageService
@inject NotificationsManager _tribeNotificationsLoclStorageAndServerManager;
@inject EventBroadcastService _eventBroadcastService;

@if (NotificationsToDisplay is not null)
{
    <button class="button" ><span>Clean notifications</span></button>

    @if (NotificationsToDisplay.Any())
    {
        foreach (var item in NotificationsToDisplay)
        {
            <p>@item.HumanUnitId (@item.Added) => @item.Type.ToString()</p>
        }
    }
    else
    {
        <p>Nothing has happend...</p>
    }
}

@code {
    IEnumerable<Notification> NotificationsToDisplay;

    [ParameterAttribute]
    public int TribeId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _eventBroadcastService.OnAction += EventHandler;
        await RefreshNotifications();        
    }

    private void EventHandler(EActionWASM actionWASM)
    {
        if (actionWASM != EActionWASM.NotificationAdded)
            return;

        RefreshNotifications();
        _eventBroadcastService.ClearEvent();
    }

    internal async Task RefreshNotifications()
    {
        NotificationsToDisplay = await _tribeNotificationsLoclStorageAndServerManager.Get();
        StateHasChanged();
    }
}
