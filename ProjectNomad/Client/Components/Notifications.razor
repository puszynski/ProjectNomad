@using Blazored.LocalStorage;
@using ProjectNomad.Client.Logic;
@inject HttpClient _httpClient
@inject ILocalStorageService _localStorageService
@inject TribeNotificationsLoclStorageAndServerManager _tribeNotificationsLoclStorageAndServerManager;

@if (TribeNotifications is not null)
{
    @if (TribeNotifications.Any())
    {
        foreach (var item in TribeNotifications)
        {
            <p>@item.HumanUnitId => @item.Type.ToString()</p>
        }
    }
    else
    {
        <p>Nothing has happend...</p>
    }

}

@* todo when clicked - display info "waitng for news.." - after few sec button is back *@
<button type="button" class="btn btn-link" @onclick="RefreshNotifications">Ask tribe members for news</button>




@code {
    List<TribeNotificationDto> TribeNotifications = new List<TribeNotificationDto>();

    [ParameterAttribute]
    public int TribeId { get; set; }

    protected override async Task OnInitializedAsync() 
        => await RefreshNotifications();

    public async Task RefreshNotifications()
    {
        await _tribeNotificationsLoclStorageAndServerManager.GetAllAndRemoveOutdated(TribeId);
        TribeNotifications = _tribeNotificationsLoclStorageAndServerManager.TribeNotifications;        
        StateHasChanged();
    }

    internal class TribeNotificationDto : ProjectNomad.Shared.Interfaces.ITribeNotification
    {
        public int HumanUnitId { get; set; }
        public DateTime Added { get; set; }
        public ProjectNomad.Shared.Enums.EHumanNotificationType Type { get; set; }
    }
}
