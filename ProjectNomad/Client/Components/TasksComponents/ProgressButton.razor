@using ProjectNomad.Client.Logic;
@using ProjectNomad.Shared.Enums;
@inject EventBroadcastService _eventBroadcastService


<br/>
<button type="button" class="progress_button">
    <div class="progress_button_progress" style="width: @ReversePercentage%;"></div>
    <div class="progress_button_text">@description (@HumanUnitTask.HumanUnitName @RemainingTimeToDisplay@GetDestinyLocalization())</div>
</button>




@code {
    [ParameterAttribute]
    public ProjectNomad.Shared.Interfaces.IHumanTaskDto HumanUnitTask { get; set; }

    int ReversePercentage = 100;
    string RemainingTimeToDisplay = string.Empty;
    string description = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        description = TaskTypeExtensions.GetDescription(HumanUnitTask.Type);

        UpdatePercentage();
        await UpdateRemainingTimeToDisplay();

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
        {
            UpdatePercentage();
            var isTaskEnded = await UpdateRemainingTimeToDisplay();

            if (isTaskEnded)
                break;
        }
    }

    string GetDestinyLocalization()
    {
        if (HumanUnitTask.LocalizationX.HasValue && HumanUnitTask.LocalizationY.HasValue)
            return $" ( => {HumanUnitTask.LocalizationX}|{HumanUnitTask.LocalizationY})";

        return string.Empty;
    }

    void UpdatePercentage()
    {
        // max_time eg. 30min       100%
        // current eg.  12min       x      x=12*100/30

        var actuall = DateTime.UtcNow - HumanUnitTask.From;
        var max = HumanUnitTask.To - HumanUnitTask.From;
        var percentage = (int)(actuall.TotalSeconds * 100 / max.TotalSeconds);
        ReversePercentage = 100 - percentage;
    }

    async Task<bool> UpdateRemainingTimeToDisplay()
    {
        var isTaskEnded = false;

        var timeLeft = HumanUnitTask.To - DateTime.UtcNow;

        if (timeLeft.Seconds < 0)
        {
            _eventBroadcastService.AddEvent(EActionWASM.NotificationAdded);
            _eventBroadcastService.AddEvent(EActionWASM.TaskEnded);
            return true;
        }

        RemainingTimeToDisplay = $"{timeLeft.Hours}h{timeLeft.Minutes}m{timeLeft.Seconds}s";
        StateHasChanged();
        return false;
    }
}
