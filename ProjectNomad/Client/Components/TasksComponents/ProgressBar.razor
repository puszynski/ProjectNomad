@using ProjectNomad.Client.Logic;
@using ProjectNomad.Shared.Enums;

@inject TasksManager _humanUnitTasksLocalStorageManager
@inject EventBroadcastService _eventBroadcastService
@inject GameLooperManager _gameLooperManager

@if (ProgressBarDisplay != null)
{
    <small>[@ProgressBarDisplay] @HumanUnitTask.HumanUnitName, @RemainingTimeToDisplay</small>
    <br />    
}

@code {
    [ParameterAttribute]
    public ProjectNomad.Shared.Interfaces.IHumanUnitTaskDto HumanUnitTask { get; set; }

    [ParameterAttribute]
    public int TribeId { get; set; }

    const char DONE = '▬';
    const char TODO = '-';

    string ProgressBarDisplay = string.Empty;
    string RemainingTimeToDisplay = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        UpdateProgressBarDisplay();
        await UpdateRemainingTimeToDisplay();

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
        {
            UpdateProgressBarDisplay();
            var isTaskEnded = await UpdateRemainingTimeToDisplay();

            if (isTaskEnded)
                break;
        }
    }

    void UpdateProgressBarDisplay()
    {
        // yy=7.33      x      x=yy*30/max
        // 10min       max=30

        var actuall = DateTime.UtcNow - HumanUnitTask.From;
        var max = HumanUnitTask.To - HumanUnitTask.From;
        string barToUpdate = string.Empty;

        var barWidth = 25; //was 30

        for (int i = 1; i <= barWidth; i++)
            barToUpdate += (actuall.TotalSeconds * barWidth / max.TotalSeconds) >= i ? DONE : TODO;

        ProgressBarDisplay = barToUpdate;
    }

    async Task<bool> UpdateRemainingTimeToDisplay()
    {
        var isTaskEnded = false;

        var timeLeft = HumanUnitTask.To - DateTime.UtcNow;

        if (timeLeft.Seconds < 0)
        {
            //await _gameLooperManager.AddNotificationFromWASM(HumanUnitTask.HumanUnitId, ENotificationType.FoodGatheringEnded, "123 todo"); //that type will be created from server!
            _eventBroadcastService.AddMessage(EActionWASM.NotificationAdded);
            _eventBroadcastService.AddMessage(EActionWASM.TaskEnded);
            return true;
        }

        RemainingTimeToDisplay = $"{timeLeft.Hours}h{timeLeft.Minutes}m{timeLeft.Seconds}s";
        StateHasChanged();
        return false;
    }
}
