@using ProjectNomad.Client.Models.Response;
@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.ViewModels.Game;
@using ProjectNomad.Shared;

@inject HttpClient _httpClient
@inject EventBroadcastService _eventBroadcastService


     @* https://stackoverflow.com/questions/26342182/style-table-as-ascii-art-table-using-css *@
        

<center>
    <div class="minimap-container">
        @if (mapViewModel != null)
        {
            @foreach (var mapTilesInRow in mapViewModel.MapTiles.Chunk(31))
            {
                <div class="minimap-row-wrapper">
                    @foreach (var mapTile in mapTilesInRow)
                    {
                        <div class="minimap-row-content">
                            <ProjectNomad.Client.Components.MiniMapComponents.MiniMapTileComponent MapTile=mapTile />
                        </div>
                    }
                </div>
            }
        }
    </div>
</center>


