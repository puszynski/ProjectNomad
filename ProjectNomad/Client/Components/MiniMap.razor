@using ProjectNomad.Client.Models.Response;
@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.ViewModels.Game;
@using ProjectNomad.Shared;

@inject HttpClient _httpClient
@inject EventBroadcastService _eventBroadcastService


     @* https://stackoverflow.com/questions/26342182/style-table-as-ascii-art-table-using-css *@

    <div style="position: relative;
                        border: 2px dashed;
                        border-color: Gainsboro;
                        width:562px;
                        height:562px;
                        margin: auto;">
        <center>
        <asciiart>
            @if (mapViewModel != null)
            {
                var row = 0;
                var column = 0;

                @* map tiles: ⚺ ⛼ ≈   ❆ ❄  ⩓  ∷   ◉ ↟↑⥾↿⥣↾⇈  *@

                foreach (var mapTile in mapViewModel.MapTiles)
                {
                    var characterToDisplay = string.Empty;

                    @switch (mapTile.Type)
                    {
                        case ProjectNomad.Shared.Enums.EMapType.DenseConiferousForest: characterToDisplay = "∷"; break;
                        case ProjectNomad.Shared.Enums.EMapType.MediumConiferousForest: characterToDisplay = "∵"; break;
                        case ProjectNomad.Shared.Enums.EMapType.RareConiferousForest: characterToDisplay = "·"; break;
                        case ProjectNomad.Shared.Enums.EMapType.HighMountains: characterToDisplay = "▲"; break;


                        default: characterToDisplay = "≈"; break; @*emtpy  means ocean*@
                    }   

                    @if (mapTile.X == Tribe.X && mapTile.Y == Tribe.Y)
                    {
                        characterToDisplay = "◉"; //should be dependent from population..  like in maps..
                    }

<span>@characterToDisplay</span>

                    @if (row == 30) @* width of the map minus one tile *@
                    {
                        <br/>
                        row = 0;
                        ++column;
                    }
                    else
                    {
                        ++row;
                    }
                }
            }
            else
            {
                <p>loading..</p>
            }
        </asciiart>
        </center>
    </div>


@* <div>
    <p>legend</p>
    <p>tent => 	⚻ ⋏ ∧ ⋀ ∩ ⋂ ⊓ ⊼ ◬ ◮ ☖ ☗ ⛰ ⛫</p>
    <p>shaman/hero tent => 	⛩</p>
    <p>storage =>	⛼ ⛶</p>
    <p>fire => 	❍ ※ ⋇ ❊ ❋ ❉</p>
    <p>behaviour => ☮ ☯ ♆ ⚔</p>
    <p>others => 🕶 </p>
</div> *@



@code {
    [ParameterAttribute]
    public Tribe Tribe { get; set; }


    private MapViewModel? mapViewModel;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    async Task Reload()
    {
        var mapTiles = await _httpClient.GetFromJsonAsync<IEnumerable<MapTileViewModel>>($"api/game/getMiniMapTiles/{Tribe.Id}");

        if (mapTiles == null)
            throw new NullReferenceException("MapTileViewModels null. No data was returned from server.");

        mapViewModel = new MapViewModel { MapTiles = mapTiles };
        StateHasChanged();
    }

}
