@code {
    [ParameterAttribute]
    public Tribe Tribe { get; set; }


    private MapViewModel? mapViewModel;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    async Task Reload()
    {
        var mapTiles = await _httpClient.GetFromJsonAsync<IEnumerable<MapTileViewModel>>($"api/game/getMiniMapTiles/{Tribe.Id}");

        if (mapTiles == null)
            throw new NullReferenceException("MapTileViewModels null. No data was returned from server.");

        mapViewModel = new MapViewModel { MapTiles = mapTiles };
        StateHasChanged();
    }

}
