@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.ViewModels.Game;
@using ProjectNomad.Client.Models.Response;
@inject EventBroadcastService _eventBroadcastService;

@if (GameObjectsViewModel != null)
{
    <smaller>population </smaller>  <b> @GameObjectsViewModel.HumanUnits.Count()</b>
    <smaller>position </smaller>    <b> @GameObjectsViewModel.Tribe.X|@GameObjectsViewModel.Tribe.Y</b>
    <smaller>fresh food</smaller>   <b> @GameObjectsViewModel.Tribe.FreshFood</b><smaller>(-6)</smaller>
    <smaller>wood </smaller>        <b> @GameObjectsViewModel.Tribe.Wood</b>
    <b> @GameObjectsViewModel.WorldParameters.AverageTemperature°C </b>
}
else
{
    <p>loading...</p>
}


@code {
    [Parameter]
    public TribeGameObjectsViewModel GameObjectsViewModel { get; set; } //TODO WORLD PARAMETERS SIĘ NIE MAPUJE..

    protected override async Task OnInitializedAsync()
    {
    }
}
