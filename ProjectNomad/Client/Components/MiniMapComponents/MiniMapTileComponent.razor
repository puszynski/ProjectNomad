@using ProjectNomad.Client.Logic
@using ProjectNomad.Client.Models.Response;
@using ProjectNomad.Client.ViewModels.Game;
@using ProjectNomad.Shared;

@inject EventBroadcastService _eventBroadcastService;

<div style="position: absolute; background-color:@BackGroundColour" 
    @onmouseover=SetActiveBackground 
    @onmouseout=SetDefaultBackground 
    @onclick=ActivateMapTileSelection>

    @if (MapTile.Type is ProjectNomad.Shared.Enums.EMapType.Ocean)
    {
        var waveSymbol = "𝀈";

        <div class="minimap-tile-row-container">
            <div class="minimap-tile-row-content minimap-character-color-veryverydark" style="font-size:10px;">@waveSymbol</div>
            <div class="minimap-tile-row-content"></div>
            <div class="minimap-tile-row-content minimap-character-color-veryverydark">@waveSymbol</div>
        </div>
        <div class="minimap-tile-row-container">
            <div class="minimap-tile-row-content"></div>
            <div class="minimap-tile-row-content minimap-character-color-veryverydark">@waveSymbol</div>
            <div class="minimap-tile-row-content"></div>
        </div>
        <div class="minimap-tile-row-container">
            <div class="minimap-tile-row-content minimap-character-color-veryverydark">@waveSymbol</div>
            <div class="minimap-tile-row-content"></div>
            <div class="minimap-tile-row-content minimap-character-color-veryverydark" style="font-size:12px;"></div>
        </div>
    }  
    else if (MapTile.Type is ProjectNomad.Shared.Enums.EMapType.Forest)
    {
        @for (int y = 0; y < 3; y++)
        {
            var riverside = ".";//todo
            var noForest = ":";
            var forest = "↟";// "+";
            var camp = "◉";

            var cave = "⛉"; //⛊ ⛰ ⌆ ⌅ ⎚ ≏ ⊕ ↈ ⁜
            @* var noForest = "𝈻"; 
            var forest = "✕"; *@

            <div class="minimap-tile-row-container">
                @for (int x = 0; x < 3; x++)
                {
                    @if (IsCamp && x == 1 && y == 1)
                    {
                        <div class="minimap-tile-row-content minimap-character-color-darkerer thicker" style="font-size:14px;">
                            @camp
                        </div>
                    }
                    else
                    {
                        <div class="minimap-tile-row-content minimap-character-color-verydark thicker">
                            @((MapTile.WoodPoints / 10) > y + 1 * x + 1 ? forest : noForest)
                            @* ✕ ⤫ + -*@
                        </div>
                    }
                }
            </div>
        }

    
    }
    else @* mountains *@
    {
        @for (int z = 0; z < 3; z++)
        {
            <div class="minimap-tile-row-container">
                @for (int y = 0; y < 3; y++)
                {
                    <div class="minimap-tile-row-content minimap-character-color-verydark">
                        ▲
                    </div>
                }
            </div>
        }
    }
        
</div>

@if (BackGroundColour == "#FFFFFF")
{
    <div style="position: relative; z-index: 1; left: 60px;">
        <button type="button" class="button_active" style="width: 80px;">@MapTile.Type (@MapTile.X|@MapTile.Y)</button>
        <button type="button" class="button_active" style="width: 80px;">wood: @MapTile.WoodPoints</button>
        <button type="button" class="button_active" style="width: 80px;">food: @MapTile.FoodPoints</button>
    </div>
}

@code {
    [ParameterAttribute]
    public MapTileViewModel MapTile { get; set; }

    [ParameterAttribute]
    public bool IsCamp { get; set; }

    string BackGroundColour = "transparent";
    void SetActiveBackground() => BackGroundColour = "#FFFFFF";
    void SetDefaultBackground() => BackGroundColour = "transparent";

    void ActivateMapTileSelection() => _eventBroadcastService.AddEvent(EActionWASM.MapTileSelected, $"{MapTile.X} {MapTile.Y}"); //jak skomunikować się z głównym elementem?
}
