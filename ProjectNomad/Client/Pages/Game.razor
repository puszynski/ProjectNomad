@page "/game"
@using Blazored.LocalStorage;
@using ProjectNomad.Client.ViewModels.Game
@inject HttpClient _http
@inject ILocalStorageService _localStorageService


@if (gameObjectsViewModel != null)
{
    @if (!gameObjectsViewModel.HumanUnits.Any())
    {
        <p>All members of your tribe have died.. </p>
        <button class="btn btn-primary" @onclick="ReBornTribeMembers">Reborn tribe with new members</button>
    }
    else
    {

        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    margin: auto;
                    width: 50%;
                    padding: 10px;">
            <b>
                population: @gameObjectsViewModel.HumanUnits.Count() &emsp; position: (@gameObjectsViewModel.Tribe.X | @gameObjectsViewModel.Tribe.Y)
            </b>
        </div>

        <br />

        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    display: table;
                    margin: auto;
                    width: 1500px; /*Optional*/
                    table-layout: fixed; /*Optional*/
                    border-spacing: 10px; /*Optional*/">
            
            <div style="border: 2px dashed;
                        border-color: Gainsboro;
                        display: table-cell;">
                Tasks:
            </div>

            <div style="border: 2px dashed;
                        border-color: Gainsboro;
                        width: 700px;
                        display: table-cell;">


                <br />

                <div style="position: relative;
                            border: 2px dashed;
                            border-color: Gainsboro;
                            width:562px;
                            height:562px;
                            margin: auto;">

                    @* IMG MAP TILES - FILE SIZE 100x100, COVERING MARGIN 10x, INNER MARGIN 2px => COLOUR TILE 76x76px *@
                    @for (int y = 0; y < 7; y++)
                    {
                        for (int x = 0; x < 7; x++)
                        {
                            <img src="/images/game/map/tile_100x100margin_80x80main.png"
                                 height="100" 
                                 width="100" 
                                 style="position: absolute; 
                                        left: @(x * 80 -10)px; 
                                        top: @(y * 80 -10)px" />
                        }
                    }

                    <br />

                    @* SVG MAP TILES *@
                    @for (int i = 0; i < 49; i++)
                    {
                        @* @if (i == 0)
                        {

                            <img src="/images/game/map/witleWithMargin_84_84_for_80_80.png" height="84" width="84" style="position: relative; left: 84px; top: 84px" />
                        } *@


                        @* <svg width="@MediumTileSizePixels" height="@MediumTileSizePixels" style="margin:2px;">
                            <rect width="@MediumTileSizePixels" height="@MediumTileSizePixels" style="fill:Gainsboro;" />
                            @if(i < 25)
                            {
                                <image href="/images/game/map/tileV2_sized.png" height="80" width="80" />

                            }
                            else
                            {
                                <image href="/images/game/map/tileV2_purePixel.png" height="80" width="80" />

                            }
                        </svg> *@
                    }

                </div>
                
            </div>

            <div style ="border: 2px dashed;
                         border-color: Gainsboro;
                         display: table-cell;">
                Tribe plots:
            </div>
            
        </div>

        <p>tribe name <b>@gameObjectsViewModel.Tribe.Name (@gameObjectsViewModel.Tribe.X, @gameObjectsViewModel.Tribe.Y)</b></p>
        <p>members count <b>@gameObjectsViewModel.HumanUnits.Count()</b></p>

        <p> @(string.Join(" - ", gameObjectsViewModel.HumanUnits.Select(x => x.FoodLevelPercentage)))</p>

        <ProjectNomad.Client.Components.Notifications TribeId="@gameObjectsViewModel.Tribe.Id" />
        <button class="btn btn-primary" @onclick="TrigerRecalculation">Check what tribes do</button>
    }
}
else
{
    <p>Ładuję dane..</p>
}


@code {
    private TribeGameObjectsViewModel gameObjectsViewModel;
    private int TileSizePixels = 120;
    private int MediumTileSizePixels = 80;

    protected override async Task OnInitializedAsync()
    {
        await UpdateDataFromServer();
    }

    async Task UpdateDataFromServer()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (!accountId.HasValue)
        {
            //redirect to login page?
            throw new ArgumentNullException("Guid from _localStorageService should not be null in game window");
        }

        var result = await _http.GetFromJsonAsync<TribeGameObjectsViewModel>($"api/game/getGameObjects/{accountId}");

        gameObjectsViewModel = new TribeGameObjectsViewModel(_http)
            {
                Tribe = result.Tribe,
                HumanUnits = result.HumanUnits
            };
    }

    async Task ReBornTribeMembers()
    {
        await gameObjectsViewModel.ReBornTribeMembers();
        await UpdateDataFromServer();
        StateHasChanged();
    }

    async Task TrigerRecalculation()
    {
        await gameObjectsViewModel.TrigerRecalculation();
        await UpdateDataFromServer();
        StateHasChanged();
    }
}
