@implements IDisposable
@page "/game"

@using ProjectNomad.Client.ViewModels.Game;
@using Blazored.LocalStorage;
@using ProjectNomad.Client.Logic;
@using ProjectNomad.Shared.Interfaces;
@using ProjectNomad.Client.Models.Response;


@inject HttpClient _httpClient
@inject GameLooperManager _gameLooperManager
@inject NavigationManager _navigationManager
@inject ILocalStorageService _localStorageService


@if (GameObjectsViewModel != null)
{   
    <div class="TopRightCornerMenu">
        ☀
    </div>

    @* <p>
        ☀ ☁ ❄ ⛆ ⛈ ⛏ ⚶ ♂ ♀ 
    </p> *@

    <div style="border: 2px dashed;
                border-color: Gainsboro;
                margin: auto;
                width: 50%;
                padding: 0px;">
        <center>
            <button class="button" @onclick="DisplayMap"><span>HOME</span></button>
            <button class="button" @onclick="DisplayMiniMap"><span>MAP</span></button>
            <button class="button" @onclick="NavigateToOptions"><span>OPTIONS</span></button>


            <br/>
            <ProjectNomad.Client.Components.BasicStatsBar GameObjectsViewModel="GameObjectsViewModel" />

            <br />
            <ProjectNomad.Client.Components.GameTimeDisplayer />
        </center>
    </div>

    <br />

    <div style="border: 2px dashed;
                border-color: Gainsboro;
                display: table;
                margin: auto;
                width: 1500px; /*Optional*/
                table-layout: fixed; /*Optional*/
                border-spacing: 10px; /*Optional*/">
        
        <div id="tasks" style="border: 2px dashed;
                    border-color: Gainsboro;
                    display: table-cell;">
          
            
            <ProjectNomad.Client.Components.Tasks 
            Tribe="GameObjectsViewModel.Tribe" 
            HumanUnitIds="GameObjectsViewModel.HumanUnits.Select(x =>x.Id).ToList()"
            HumanUnitTaskOrders="GameObjectsViewModel.HumanUnitTaskOrders" 
            HumanUnitTasks="GameObjectsViewModel.HumanUnitTasks"
            TribeStructures="GameObjectsViewModel.TribeStructures"/>
        </div>

        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    width: 700px;
                    display: table-cell;">

            @if (MainGameWindow == "Map")
            {
                <ProjectNomad.Client.Components.Map Tribe="@GameObjectsViewModel.Tribe" />
            }
            else
            {
                <ProjectNomad.Client.Components.MiniMap Tribe="@GameObjectsViewModel.Tribe" />
            }

        </div>
        
        <div id="notifications" style ="border: 2px dashed;
                     border-color: Gainsboro;
                     display: table-cell;">
            <ProjectNomad.Client.Components.Notifications TribeId="@GameObjectsViewModel.Tribe.Id" />
        </div>
        
    </div>
    
}
else
{
    <p>loading..</p>
}


@code {
    //child-to-child communication tut https://somegenericdev.medium.com/how-to-pass-a-value-between-sibling-components-in-blazor-1b4ec805cf31

    private TribeGameObjectsViewModel GameObjectsViewModel;
    private bool ShouldBreak = false;

    protected override async Task OnInitializedAsync()
    {
        await TrigerRecalculationAndGetGameObjectsFromServer();

        if (!GameObjectsViewModel.HumanUnits.Any())
            return;

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
        {
            if (ShouldBreak)
                break;

            await TrigerRecalculationAndGetGameObjectsFromServer();
        }
    }

    async Task TrigerRecalculationAndGetGameObjectsFromServer() //WYNIEŚĆ DO SERWISU ŻEBY INNE PAGE TEZ MOGLY Z TEGO KORZYSTAĆ
    {
        var accountId = await GetAccountIdOr404();

        var result = await _gameLooperManager.TriggerGameLooper(accountId);

        GameObjectsViewModel = new TribeGameObjectsViewModel
        {
            Tribe = result.Tribe,
            HumanUnits = result.HumanUnits,
            HumanUnitTaskOrders = result.HumanUnitTaskOrders,
            HumanUnitTasks = result.HumanUnitTasks,
            TribeStructures = result.TribeStructures
        };

        StateHasChanged();
    }

    async Task<Guid> GetAccountIdOr404()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (!accountId.HasValue)
            throw new ArgumentNullException("Guid from _localStorageService cant be null in game window");

        return accountId.Value;
    }

    string MainGameWindow = "Map";
    void DisplayMiniMap() => MainGameWindow = "MiniMap";
    void DisplayMap() => MainGameWindow = "Map";

    void NavigateToOptions()
        => _navigationManager.NavigateTo($"options");

    void IDisposable.Dispose()
    {
        ShouldBreak = true;
    }
}
