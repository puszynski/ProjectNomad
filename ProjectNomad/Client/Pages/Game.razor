@page "/game"
@using Blazored.LocalStorage;
@using ProjectNomad.Client.ViewModels.Game
@using ProjectNomad.Shared.Interfaces;
@inject HttpClient _http
@inject ILocalStorageService _localStorageService


@if (GameObjectsViewModel != null)
{
    @if (!GameObjectsViewModel.HumanUnits.Any())
    {
        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    margin: auto;
                    width: 50%;
                    padding: 10px;">
            @* todo dispLay in middle *@
            @* TODO COMPONENT *@
            <img src="/images/game/todo_death.png" style="margin: auto;" />

            <h5>All members of your tribe have died.. </h5>
            <button class="btn btn-primary" @onclick="ReBornTribeMembers">Reborn tribe with new members</button>
        </div>
        
    }
    else
    {
        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    margin: auto;
                    width: 50%;
                    padding: 10px;">
        @* TODO COMPONENT *@
            <smaller>population </smaller>  <b> @GameObjectsViewModel.HumanUnits.Count()</b>                        &emsp;
            <smaller>position </smaller>    <b> @GameObjectsViewModel.Tribe.X|@GameObjectsViewModel.Tribe.Y</b>     &emsp;
            <smaller>fresh food</smaller>   <b> @GameObjectsViewModel.Tribe.FreshFood</b>                           &emsp; 
            <smaller>wood </smaller>        <b> @GameObjectsViewModel.Tribe.Wood</b>
        </div>

        <br />

        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    display: table;
                    margin: auto;
                    width: 1500px; /*Optional*/
                    table-layout: fixed; /*Optional*/
                    border-spacing: 10px; /*Optional*/">
            
            <div id="tasks" style="border: 2px dashed;
                        border-color: Gainsboro;
                        display: table-cell;">
                <ProjectNomad.Client.Components.TaskAssigner TribeId="GameObjectsViewModel.Tribe.Id" HumanUnits="GameObjectsViewModel.HumanUnits" TilePositionX="@GameObjectsViewModel.Tribe.X" TilePositionY="GameObjectsViewModel.Tribe.Y" />
                <ProjectNomad.Client.Components.Tasks TribeId="GameObjectsViewModel.Tribe.Id" HumanUnitIds="GameObjectsViewModel.HumanUnits.Select(x => x.Id).ToList()" />
            </div>

            <div style="border: 2px dashed;
                        border-color: Gainsboro;
                        width: 700px;
                        display: table-cell;">
                <ProjectNomad.Client.Components.MiniMap TribeId="@GameObjectsViewModel.Tribe.Id" />
            </div>
            
            <div id="notifications" style ="border: 2px dashed;
                         border-color: Gainsboro;
                         display: table-cell;">
                <ProjectNomad.Client.Components.Notifications TribeId="@GameObjectsViewModel.Tribe.Id" @ref="NotificationComponentReference" />
            </div>
            
        </div>

        <p> @(string.Join(" - ", GameObjectsViewModel.HumanUnits.Select(x => x.FoodLevelPercentage)))</p>
    }
}
else
{
    <p>Ładuję dane..</p>
}


@code {
    private TribeGameObjectsViewModel GameObjectsViewModel;

    protected override async Task OnInitializedAsync()
    {
        await GetDataFromServer();
        await TrigerRecalculation();
        await GetDataFromServer(); //IDEA its preventing null when all died after recalculation, think how to prevent doubled server requests..

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(61));

        while (await timer.WaitForNextTickAsync())
        {
            await TrigerRecalculation(); //IDEA use game looper stright from blazorWASM?
        }
    }

    async Task GetDataFromServer()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (!accountId.HasValue)
        {
            //redirect to login page?
            throw new ArgumentNullException("Guid from _localStorageService should not be null in game window");
        }

        var result = await _http.GetFromJsonAsync<TribeGameObjectsViewModel>($"api/game/getGameObjects/{accountId}");

        GameObjectsViewModel = new TribeGameObjectsViewModel(_http)
        { 
            Tribe = result.Tribe, 
            HumanUnits = result.HumanUnits 
        };
    }

    async Task ReBornTribeMembers()
    {
        await GameObjectsViewModel.ReBornTribeMembers();
        await GetDataFromServer();
        StateHasChanged();
    }

    async Task TrigerRecalculation()
    {
        var tribeCountBeforeRecalculation = GameObjectsViewModel.HumanUnits?.Count();

        await GameObjectsViewModel.TrigerRecalculation();
        await GetDataFromServer();

        if (tribeCountBeforeRecalculation != null && tribeCountBeforeRecalculation != GameObjectsViewModel.HumanUnits.Count())
            await RefreshNotifications();

        StateHasChanged();
    }
    
    protected ProjectNomad.Client.Components.Notifications NotificationComponentReference;
    async Task RefreshNotifications() => await NotificationComponentReference.RefreshNotifications();
}
