@page "/game"
@using Blazored.LocalStorage;
@using ProjectNomad.Client.ViewModels.Game
@inject HttpClient _http
@inject ILocalStorageService _localStorageService


<h3>Game is running!</h3>

@if (gameObjectsViewModel != null)
{
    <p>tribe name <b>@gameObjectsViewModel.Tribe.Name (@gameObjectsViewModel.Tribe.X, @gameObjectsViewModel.Tribe.Y)</b></p>
    <p>members count <b>@gameObjectsViewModel.HumanUnits.Count()</b></p>

    <p> @(string.Join(" - ", gameObjectsViewModel.HumanUnits.Select(x => x.FoodLevelPercentage)))</p>

    <button class="btn btn-primary" @onclick="gameObjectsViewModel.TrigerRecalculation">Check what tribes do</button>
}
else
{
    <p>Ładuję dane..</p>
}


@code {
    private TribeGameObjectsViewModel gameObjectsViewModel;

    protected override async Task OnInitializedAsync()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (!accountId.HasValue)
        {
            //redirect to login page?
            throw new ArgumentNullException("Guid from _localStorageService should not be null in game window");
        }

        var result = await _http.GetFromJsonAsync<TribeGameObjectsViewModel>($"api/game/getGameObjects/{accountId}");

        gameObjectsViewModel = new TribeGameObjectsViewModel(_http)
            {
                Tribe = result.Tribe,
                HumanUnits = result.HumanUnits
            };
    }
}
