@page "/game"
@using Blazored.LocalStorage;
@using ProjectNomad.Client.ViewModels.Game
@using ProjectNomad.Shared.Interfaces;
@inject HttpClient _httpClient
@inject ILocalStorageService _localStorageService


@if (GameObjectsViewModel != null)
{
    @if (!GameObjectsViewModel.HumanUnits.Any())
    {
        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    margin: auto;
                    width: 50%;
                    padding: 10px;">
            @* todo dispLay in middle *@
            @* TODO COMPONENT *@
            <img src="/images/game/todo_death.png" style="margin: auto;" />

            <h5>All members of your tribe have died.. </h5>
            <button class="btn btn-primary" @onclick="ReBornTribeMembers">Reborn tribe with new members</button>
        </div>
        
    }
    else
    {
        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    margin: auto;
                    width: 50%;
                    padding: 0px;">
            <center>                
                <ProjectNomad.Client.Components.GameMenu />

                <br/>
                <ProjectNomad.Client.Components.BasicStatsBar GameObjectsViewModel="GameObjectsViewModel" />

                <br />
                <ProjectNomad.Client.Components.GameTimeDisplayer />
            </center>
        </div>

        <br />

        <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    display: table;
                    margin: auto;
                    width: 1500px; /*Optional*/
                    table-layout: fixed; /*Optional*/
                    border-spacing: 10px; /*Optional*/">
            
            <div id="tasks" style="border: 2px dashed;
                        border-color: Gainsboro;
                        display: table-cell;">                
                <ProjectNomad.Client.Components.TaskAssigner TribeId="GameObjectsViewModel.Tribe.Id" HumanUnits="GameObjectsViewModel.HumanUnits" TilePositionX="@GameObjectsViewModel.Tribe.X" TilePositionY="GameObjectsViewModel.Tribe.Y" />
                <ProjectNomad.Client.Components.Tasks TribeId="GameObjectsViewModel.Tribe.Id" HumanUnitIds="GameObjectsViewModel.HumanUnits.Select(x => x.Id).ToList()" />
            </div>

            <div style="border: 2px dashed;
                        border-color: Gainsboro;
                        width: 700px;
                        display: table-cell;">
                <ProjectNomad.Client.Components.MiniMap TribeId="@GameObjectsViewModel.Tribe.Id" />
            </div>
            
            <div id="notifications" style ="border: 2px dashed;
                         border-color: Gainsboro;
                         display: table-cell;">
                <ProjectNomad.Client.Components.Notifications TribeId="@GameObjectsViewModel.Tribe.Id" />
            </div>
            
        </div>

        <p> @(string.Join(" - ", GameObjectsViewModel.HumanUnits.Select(x => x.FoodLevelPercentage)))</p>
    }
}
else
{
    <p>loading..</p>
}


@code {
    private TribeGameObjectsViewModel GameObjectsViewModel;

    protected override async Task OnInitializedAsync()
    {
        await TrigerRecalculation();
        await GetDataFromServer();

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
            await TrigerRecalculation();
    }

    async Task TrigerRecalculation()
    {
        var accountId = await GetAccountIdOr404();
        await _httpClient.PostAsJsonAsync("api/game/triggerPlayerGameObjectRecalculation", accountId);

        await GetDataFromServer();
        StateHasChanged();
    }

    async Task GetDataFromServer()
    {
        var accountId = await GetAccountIdOr404();
        var result = await _httpClient.GetFromJsonAsync<TribeGameObjectsViewModel>($"api/game/getGameObjects/{accountId}");

        GameObjectsViewModel = new TribeGameObjectsViewModel
        { 
            Tribe = result.Tribe, 
            HumanUnits = result.HumanUnits 
        };
    }

    async Task ReBornTribeMembers()
    {
        var accountId = await GetAccountIdOr404();
        await _httpClient.PostAsJsonAsync("api/account/generateNewTribeMembers", accountId);
        
        await GetDataFromServer();
        StateHasChanged();
    }

    

    async Task<Guid> GetAccountIdOr404()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (!accountId.HasValue)
            throw new ArgumentNullException("Guid from _localStorageService cant be null in game window");

        return accountId.Value;
    }

}
