@implements IDisposable
@page "/game"

@using ProjectNomad.Client.ViewModels.Game;
@using Blazored.LocalStorage;
@using ProjectNomad.Client.Logic;
@using ProjectNomad.Shared.Interfaces;
@using ProjectNomad.Client.Models.Response;


@inject HttpClient _httpClient
@inject GameLooperManager _gameLooperManager
@inject NavigationManager _navigationManager
@inject ILocalStorageService _localStorageService


@if (GameObjectsViewModel != null)
{  
    <div class="header">
        <button type="button" class="button_active" @onclick="DisplayMap">home</button>
        <button type="button" class="button_active" @onclick="DisplayMiniMap">map</button>
        <button type="button" class="button_active" @onclick="NavigateToTribe">tribe</button>
        <button type="button" class="button_active" @onclick="DisplayCamp">camp</button>
        <button type="button" class="button_active" @onclick="NavigateToOptions">options</button>
        <br />
        <ProjectNomad.Client.Components.BasicStatsBar GameObjectsViewModel="GameObjectsViewModel" />

        @* <br />
        <ProjectNomad.Client.Components.GameTimeDisplayer /> *@
    </div>

    <div class="row">
        <div class="column side">
            <div style="width: 250px; float: right;">
                <div>
                    <ProjectNomad.Client.Components.Tasks Tribe="GameObjectsViewModel.Tribe"
                                                          HumanUnitIds="GameObjectsViewModel.HumanUnits.Select(x =>x.Id).ToList()"
                                                          HumanUnitTaskOrders="GameObjectsViewModel.HumanUnitTaskOrders"
                                                          HumanUnitTasks="GameObjectsViewModel.HumanUnitTasks"
                                                          TribeStructures="GameObjectsViewModel.TribeStructures" />
                </div>

                <div>
                    <ProjectNomad.Client.Components.Notifications TribeId="@GameObjectsViewModel.Tribe.Id" />
                </div>
            </div>
        </div>

        <div class="column main">
            <div style="float: left;">
                @if (MainGameWindow == "Map")
                {
                    <ProjectNomad.Client.Components.Map Tribe="@GameObjectsViewModel.Tribe" />
                }
                else if (MainGameWindow == "Camp")
                {
                    <ProjectNomad.Client.Components.Camp />
                }
                else
                {
                    <ProjectNomad.Client.Components.MiniMap Tribe="@GameObjectsViewModel.Tribe" />
                }

                <small>@GetImportantInfoMessage()</small>
            </div>
        </div>
    </div>

    <div class="footer">
        <center>
            <smaller> pr◯ject n◯mad &nbsp;&nbsp; 2023 - early development version</smaller>
        </center>
    </div>
}
else
{
    @* todo - logo animation/music + some qotes - with const time - to hide loading time for run game looper *@
    <p>loading..</p>
}


@code {
    //child-to-child communication tut https://somegenericdev.medium.com/how-to-pass-a-value-between-sibling-components-in-blazor-1b4ec805cf31

    private TribeGameObjectsViewModel GameObjectsViewModel;
    private bool ShouldBreak = false;

    protected override async Task OnInitializedAsync()
    {
        await TrigerRecalculationAndGetGameObjectsFromServer();

        if (GameObjectsViewModel == null || !GameObjectsViewModel.HumanUnits.Any())
            return;

        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync())
        {
            if (ShouldBreak)
                break;

            await TrigerRecalculationAndGetGameObjectsFromServer();
        }
    }

    async Task TrigerRecalculationAndGetGameObjectsFromServer() //WYNIEŚĆ DO SERWISU ŻEBY INNE PAGE TEZ MOGLY Z TEGO KORZYSTAĆ
    {
        var accountId = await GetAccountIdOr404();

        var result = await _gameLooperManager.TriggerGameLooper(accountId);

        if (result == null)
            return;

        GameObjectsViewModel = new TribeGameObjectsViewModel
        {
            Tribe = result.Tribe,
            HumanUnits = result.HumanUnits,
            HumanUnitTaskOrders = result.HumanUnitTaskOrders,
            HumanUnitTasks = result.HumanUnitTasks,
            TribeStructures = result.TribeStructures,
            WorldParameters = result.WorldParameters
        };

        StateHasChanged();
    }

    async Task<Guid> GetAccountIdOr404()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (!accountId.HasValue)
            throw new ArgumentNullException("Guid from _localStorageService cant be null in game window");

        return accountId.Value;
    }

    string GetImportantInfoMessage()
    {
        var messages = new List<string>();

        if (GameObjectsViewModel.HumanUnits.Any(x => x.ThermalLevelPercentage <= 10))
        {
            var names = GameObjectsViewModel.HumanUnits
                .Where(x => x.ThermalLevelPercentage <= 10)
                .Select(x => x.Name)
                .ToList();

            messages.Add($"{string.Join(", ", names)} freezing");
        }
        else if (GameObjectsViewModel.HumanUnits.Any(x => x.ThermalLevelPercentage <= 30))
        {
            var names = GameObjectsViewModel.HumanUnits
                .Where(x => x.ThermalLevelPercentage <= 30)
                .Select(x => x.Name)
                .ToList();

            messages.Add($"{string.Join(", ", names)} cold");
        }

        if (GameObjectsViewModel.HumanUnits.Any(x => x.FoodLevelPercentage <= 10))
        {
            var names = GameObjectsViewModel.HumanUnits
                .Where(x => x.FoodLevelPercentage <= 10)
                .Select(x => x.Name)
                .ToList();

            messages.Add($"{string.Join(", ", names)} starving");
        }
        else if (GameObjectsViewModel.HumanUnits.Any(x => x.FoodLevelPercentage <= 30))
        {
            var names = GameObjectsViewModel.HumanUnits
                .Where(x => x.FoodLevelPercentage <= 30)
                .Select(x => x.Name)
                .ToList();

            messages.Add($"{string.Join(", ", names)} hungry");
        }

        return string.Join(". ", messages);
    }

    string MainGameWindow = "MiniMap";
    void DisplayMiniMap() => MainGameWindow = "MiniMap";
    void DisplayCamp() => MainGameWindow = "Camp";
    void DisplayMap() => MainGameWindow = "Map";

    void NavigateToTribe()
        => _navigationManager.NavigateTo("tribe");

    void NavigateToOptions()
        => _navigationManager.NavigateTo($"options");

    void IDisposable.Dispose()
    {
        ShouldBreak = true;
        GameObjectsViewModel = null;
    }
}
