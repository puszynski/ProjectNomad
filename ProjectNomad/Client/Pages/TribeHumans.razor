@page "/tribe"
@* todo change to tribeHumans *@

@using Blazored.LocalStorage;
@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.Models.Response;
@using ProjectNomad.Client.ViewModels.TribeHumans
@using ProjectNomad.Shared.DTOs.ServerToWasm

@inject HttpClient _httpClient
@inject NavigationManager _navigationManager
@inject GameLooperManager _gameLooperManager
@inject ILocalStorageService _localStorageService


<div style="margin: auto;
            width: 700px;
            padding: 10px;">
    <center>
        <button class="button" @onclick="NavigateToIndex"><span>Back to map</span></button>
    </center>

    @if (TribeHumansWithJobs != null)
    {
        <br />
        <br />

        <center>
            <p>There are <b>@TribeHumansWithJobs.Count()</b> human units in tribe.</p>
        </center>
        <br />

        @foreach (var humanUnit in TribeHumansWithJobs)
        {
            <div class="human-card">

                <div class="container" style="padding: 2px 16px;">
                    <h4><b>@humanUnit.Human.Name</b></h4>
                    <smaller>food level: @humanUnit.Human.FoodLevel%</smaller><br />
                    <smaller>thermal level: @humanUnit.Human.ThermalLevel%</smaller>
                    <br /><br />

                    <ProjectNomad.Client.Components.TribeHumansComponents.JobComponent Jobs="humanUnit.Jobs.Select(x => (JobViewModel)x).ToList()" HumanId="humanUnit.Human.Id" />

                    @* @foreach (var job in humanUnit.Jobs)
                    {
                        <smaller>@job.Type.ToString(): </smaller>
                    }
                    <smaller>wood gather: ### [-][+]</smaller><br />
                    <smaller>food gather: # [-][+]</smaller><br />
                    <smaller>free time: ######</smaller><br /> *@
                </div>
            </div>
        }
    }
</div>

@code {

    public IEnumerable<HumanWithJobsDto> TribeHumansWithJobs { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var accountId = await GetAccountIdOr404();
        _ = await _gameLooperManager.TriggerGameLooper(accountId); //todo refresh each 10 sec?

        TribeHumansWithJobs = await _httpClient.GetFromJsonAsync<IEnumerable<HumanWithJobsDto>>($"api/game/getTribeHumansWithJobs/{accountId.ToString()}");
        StateHasChanged();
    }

    void NavigateToIndex()
        => _navigationManager.NavigateTo("/");

    async Task<Guid> GetAccountIdOr404()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (!accountId.HasValue)
            throw new ArgumentNullException("Guid from _localStorageService cant be null in game window");

        return accountId.Value;
    }
}
