@page "/"
@using Blazored.LocalStorage;
@using ProjectNomad.Client.ViewModels.Index
@inject HttpClient _http
@inject NavigationManager _navigationManager
@inject ILocalStorageService _localStorageService

@if (accountViewModel != null)
{
    <div style="border: 2px dashed;
                    border-color: Gainsboro;
                    display: table;
                    margin: auto;
                    width: 400px; /*Optional*/
                    table-layout: fixed; /*Optional*/
                    border-spacing: 10px; /*Optional*/">

                <center>
                    <p>>> p r o j e c t &nbsp;&nbsp; n o m a d &lt;&lt;</p>
                </center>
                <br/>
                <smaller>
                    <p>welcome to project nomad - simple survival game about first homo sapiens... struggling to survive.. </p>
                    <p>please note - game is early stage of development.</p>
                </smaller>
                <br/>

                <EditForm Model="accountViewModel" OnValidSubmit="accountViewModel.LogIn">
                    <div>
                        <label for="">login:</label>
                        <InputText @bind-Value="accountViewModel.Name" class="form-control"></InputText>
                    </div>
                    <div>
                        <label for="">password:</label>
                        <InputText @bind-Value="accountViewModel.Password" class="form-control"></InputText>
                    </div>
                    <div>
                        <button type="submit"  class="button"><span>PLAY</span></button>
                    </div>
                </EditForm>

                <br/>
                <button class="button" @onclick="CreateAccount"><span>CREATE ACCOUNT</span></button>
                <button class="button"><span>PLAY AS GUEST</span></button>
                <button class="button"><span>LOG AS GUEST WITH GUEST TOKEN</span></button>
    </div>

    
}

@code {
    AccountLogInViewModel accountViewModel;

    protected override async Task OnInitializedAsync()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (accountId.HasValue)
            _navigationManager.NavigateTo("game");

        accountViewModel = new(_http, _navigationManager, _localStorageService);
    }

    void CreateAccount()
        => _navigationManager.NavigateTo($"createAccount");
}