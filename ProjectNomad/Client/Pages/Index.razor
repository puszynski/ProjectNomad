@page "/"
@using Blazored.LocalStorage;
@using ProjectNomad.Client.ViewModels.Index
@inject HttpClient _http
@inject NavigationManager _navigationManager
@inject ILocalStorageService _localStorageService

@if (accountViewModel != null)
{
    <EditForm Model="accountViewModel" OnValidSubmit="accountViewModel.LogIn">
        <div>
            <label for="">login:</label>
            <InputText @bind-Value="accountViewModel.Name" class="form-control"></InputText>
        </div>
        <div>
            <label for="">password:</label>
            <InputText @bind-Value="accountViewModel.Password" class="form-control"></InputText>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">play</button>
        </div>
    </EditForm>

    <button class="btn btn-primary" @onclick="CreateAccount">Create account</button>
    <button class="btn btn-primary">Play as guest</button>
    <button class="btn btn-primary">Continue as guest with guest-key</button>
}

@code {
    AccountLogInViewModel accountViewModel;

    protected override async Task OnInitializedAsync()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (accountId.HasValue)
            _navigationManager.NavigateTo("game");

        accountViewModel = new(_http, _navigationManager, _localStorageService);
    }

    void CreateAccount()
        => _navigationManager.NavigateTo($"createAccount");
}