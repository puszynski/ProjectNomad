@page "/tribe"

@using Blazored.LocalStorage;
@using ProjectNomad.Client.Logic;
@using ProjectNomad.Client.Models.Response;

@inject NavigationManager _navigationManager
@inject GameLooperManager _gameLooperManager
@inject ILocalStorageService _localStorageService

<div style="border: 2px dashed;
                    border-color: Gainsboro;
                    margin: auto;
                    width: 500px;
                    padding: 10px;">

    <center>
        <button class="button" @onclick="NavigateToIndex"><span>Back to map</span></button>

        @if (HumanUnits != null)
        {
            <br />
            <br />

            <p>There are <b>@HumanUnits.Count()</b> human units in tribe.</p>
            <br />

            @foreach (var humanUnit in HumanUnits)
            {
                <p>@humanUnit.Name food level is @humanUnit.FoodLevelPercentage%, thermal level @humanUnit.ThermalLevelPercentage%</p>
            }
        }
    </center>

</div>

@code {
    public IEnumerable<HumanUnit> HumanUnits { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var accountId = await GetAccountIdOr404();
        var result = await _gameLooperManager.TriggerGameLooper(accountId); //gdy uderzasz 2x na sec to Trigger zwraca nulla - to tak nie może być.. 
        HumanUnits = result.HumanUnits;
        StateHasChanged();
    }

    void NavigateToIndex()
        => _navigationManager.NavigateTo("/");

    async Task<Guid> GetAccountIdOr404()
    {
        var accountId = await _localStorageService.GetItemAsync<Guid?>("id");

        if (!accountId.HasValue)
            throw new ArgumentNullException("Guid from _localStorageService cant be null in game window");

        return accountId.Value;
    }
}
